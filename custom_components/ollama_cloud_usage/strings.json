{
  "config": {
    "step": {
      "user": {
        "title": "Add Ollama Account",
        "description": "Enter your ollama.com account details. To get an API key: log in to ollama.com \u2192 Settings \u2192 API Keys \u2192 Create API Key. The key is stored in your Home Assistant config entry.",
